# Sample nginx server block for the ARM benchmark report.
#
# The report is a single static file (bench/results/index.html) pushed by
# bench/publish.sh into the web root below — there is no app to run on the host,
# just static files. Adjust server_name + root, then add TLS with certbot.
#
#   sudo install -d -o www-data -g www-data /var/www/aurora-bm
#   sudo cp nginx-aurora-bm.conf.example /etc/nginx/sites-available/aurora-bm
#   sudo ln -s /etc/nginx/sites-available/aurora-bm /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d aurora-bm.werewolf.solutions   # provisions HTTPS

server {
    listen 80;
    listen [::]:80;
    server_name aurora-bm.werewolf.solutions;

    root /var/www/aurora-bm;
    index index.html;

    # The report inlines full model outputs. Uncomment to require a login before
    # anyone can read them:
    #   sudo htpasswd -c /etc/nginx/.htpasswd-aurora-bm <username>
    # auth_basic "ARM benchmark";
    # auth_basic_user_file /etc/nginx/.htpasswd-aurora-bm;

    location / {
        try_files $uri $uri/ =404;
    }

    # The single report file is replaced on every publish — don't cache it hard,
    # or a redeploy won't show until the browser cache expires.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
