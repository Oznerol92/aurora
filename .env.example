# Aurora environment variables — TEMPLATE.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. The real environment
# always takes precedence over .env, so you can also just `export` these.

# Telegram notifications (optional — used by /notify).
# Get a token from @BotFather, and your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Override where Aurora stores config + local DB (optional).
# Defaults to ~/.config/aurora
# AURORA_CONFIG_DIR=

# Vendor API keys — used ONLY by the bench/ harness (bench/run.js) to call
# other vendors directly for comparison. Aurora itself stays Claude-only and
# needs no key (it uses your Claude Code CLI subscription auth). Optional.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
