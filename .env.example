# Aurora environment variables — TEMPLATE.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. The real environment
# always takes precedence over .env, so you can also just `export` these.

# Telegram notifications (optional — used by /notify and `aurora --serve`).
# Get a token from @BotFather. That's all you need: send your bot /start (or run
# /notify whoami in the REPL) to register your chat — Aurora remembers it locally
# in ~/.config/aurora/telegram-chats.json, so there's no chat id to copy.
TELEGRAM_BOT_TOKEN=
# Optional override: pin a single authorized chat instead of using the registry.
# TELEGRAM_CHAT_ID=

# Override where Aurora stores config + local DB (optional).
# Defaults to ~/.config/aurora
# AURORA_CONFIG_DIR=

# Vendor API keys — used ONLY by the bench/ harness (bench/run.js) to call
# other vendors directly for comparison. Aurora itself stays Claude-only and
# needs no key (it uses your Claude Code CLI subscription auth). Optional.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Benchmark report publishing to Netlify (bench/publish.sh) — optional.
# TOKEN: Netlify → User settings → Applications → new access token.
# SITE_ID: target site's API ID (Site settings → General → API ID); create the
# site once with `npx netlify-cli sites:create`.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
